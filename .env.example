# Copy this file to ".env" and adjust the values for your environment.
# The .env file is read automatically at startup by python-dotenv.

# Secret key used to sign sessions and CSRF tokens. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Database connection string.
# Local development (default) uses SQLite, so you can leave this commented out.
# For PostgreSQL in production, set it like this:
# DATABASE_URL=postgresql://username:password@localhost:5432/oil_gas_erp

# Flask environment settings (optional)
FLASK_APP=run.py
FLASK_DEBUG=1
